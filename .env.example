# OpenRouter credential - fill in your own value locally. Never commit the real key.
OPENROUTER_API_KEY=sk-or-v1-replace-me

# Model routed through OpenRouter
OPENROUTER_MODEL=minimax/minimax-m3:free

# Optional overrides (defaults used when unset)
DATABASE_PATH=
CASE_NOTES_PATH=
MEMORY_DB_PATH=
UPLOADS_DIR=
CORS_ORIGINS=http://localhost:5173
VITE_API_BASE_URL=http://localhost:8000

# Authentication (Phase 8A)
# Valid session lifetime in days; new sessions expire after this.
AUTH_SESSION_DAYS=30
# Set true when serving over HTTPS so the session cookie uses Secure.
AUTH_COOKIE_SECURE=false

# Execution channel (Phase 7A-1)
# simulated = no external side effects (DEFAULT)
# smtp      = send plain-text email via a local SMTP relay (e.g. Mailpit).
#             Requires SMTP_HOST, SMTP_FROM and SMTP_TO. Unknown values fail
#             closed and never silently fall back to simulated.
EXECUTION_CHANNEL=simulated

# Local SMTP relay settings (only used when EXECUTION_CHANNEL=smtp)
# SMTP_PORT defaults to 1025 (Mailpit default). SMTP_USERNAME/PASSWORD and
# SMTP_STARTTLS are optional. Recipient comes ONLY from SMTP_TO - never from
# the model's free-text target field.
SMTP_HOST=
SMTP_PORT=1025
SMTP_FROM=
SMTP_TO=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=false